<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Zero-Copy Monitor Surface -->
    <!-- SurfaceView Removed for Lazy Loading (v3.2.1-debug13) -->
    <FrameLayout
        android:id="@+id/monitor_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Overlay UI -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="El Ojo Del Abuelo"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:shadowColor="#000000"
            android:shadowDx="2"
            android:shadowDy="2"
            android:shadowRadius="3"
            android:layout_marginBottom="32dp" />

        <Button
            android:id="@+id/btn_activate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ACTIVAR VIGILANCIA"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <!-- DEBUG: Manual Connect Button -->
        <Button
            android:id="@+id/btn_connect_video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CONECTAR VIDEO"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btn_deactivate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DESACTIVAR"
            android:textSize="18sp" />

    </LinearLayout>
</FrameLayout>
